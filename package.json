{
  "name": "api.pfi.com",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js"
  },
  "imports": {
    "#configs": "./src/configs/index.js",
    "#configs/*": "./src/configs/*",
    "#configurations/*": "./src/configs/*",
    "#controllers/*": "./src/controllers/*",
    "#models/*": "./src/models/*",
    "#routes/*": "./src/routes/*",
    "#views/*": "./src/views/*",
    "#mvc-controllers/*": "./src/controllers/*",
    "#mvc-models/*": "./src/models/*",
    "#mvc-routes/*": "./src/routes/*",
    "#mvc-views/*": "./src/views/*",
    "#middlewares/*": "./src/middlewares/*",
    "#services/*": "./src/services/*",
    "#utils/*": "./src/utils/*",
    "#tools": "./src/utils/index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "file-type": "^22.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.3"
  }
}
